<body>
<div class="app">
  <aside id="sidebar"><div class="brand"><h1>IMPA Gestión</h1><small>Instituto Bíblico · uso local</small></div><nav id="nav">
    <button data-view="inicio" class="active">▣ Inicio</button><button data-view="alumnos">👥 Alumnos</button><div class="subject-label">Materias</div><button data-view="materia" data-subject="antropologia">📘 Antropología</button><button data-view="materia" data-subject="teologia">📗 Teología</button><button data-view="materia" data-subject="soteriologia">📙 Soteriología</button><button data-view="materia" data-subject="bibliologia">📕 Bibliología</button><button data-view="materia" data-subject="hamartiologia">📓 Hamartiología</button><div class="subject-label">Administración</div><button data-view="respaldo">↕ Respaldo</button>
  </nav></aside>
  <main><header><div><button class="btn mobile-menu" id="menuBtn">☰</button> <h2 id="viewTitle" style="display:inline">Panel de control</h2></div><span class="muted">Ciclo 2026</span></header><div id="content" class="container"></div></main>
</div>

<dialog id="studentDialog"><form id="studentForm"><div class="modal-head"><h3 id="studentDialogTitle">Alumno</h3><button type="button" class="close" data-close="studentDialog">×</button></div><div class="modal-body"><input type="hidden" name="id"><div class="form-grid">
  <div class="field span2"><label>Nombre y apellido</label><input name="nombreCompleto" class="title-case" maxlength="120"></div>
  <div class="field"><label>DNI</label><input name="dni" inputmode="numeric" maxlength="14"></div><div class="field"><label>Teléfono / WhatsApp</label><input name="telefono" inputmode="tel" maxlength="30"></div>
  <div class="field"><label>Ministerio o institución</label><input name="institucion" class="title-case" maxlength="100"></div><div class="field"><label>Localidad</label><input name="localidad" class="title-case" maxlength="80"></div>
  <div class="field"><label>Función</label><select name="rol"><option value="">Sin especificar</option><option>Pastor</option><option>Diácono</option><option>Líder</option><option>Laico</option></select></div><label class="check-field"><input type="checkbox" name="autorizado"> Tiene autorización de su cobertura</label>
  <div class="field"><label>Estado</label><select name="estado"><option>Activo</option><option>Inactivo</option></select></div>
  <div class="field span2"><label>Observaciones</label><textarea name="observaciones" rows="3" maxlength="500"></textarea></div>
</div><div class="modal-actions"><button type="button" class="btn" data-close="studentDialog">Cancelar</button><button class="btn primary">Guardar</button></div></div></form></dialog>

<dialog id="profileDialog" style="width:min(760px,calc(100% - 24px))"><div class="modal-head"><h3 id="profileTitle">Ficha del alumno</h3><button type="button" class="close" data-close="profileDialog">×</button></div><div id="profileBody" class="modal-body"></div></dialog>

<dialog id="eventDialog"><form id="eventForm"><div class="modal-head"><h3 id="eventDialogTitle">Encuentro</h3><button type="button" class="close" data-close="eventDialog">×</button></div><div class="modal-body"><input type="hidden" name="id"><div class="form-grid">
  <div class="field"><label>Fecha *</label><input type="date" name="fecha" required></div><div class="field"><label>Estado</label><select name="estado"><option value="programado">Programado</option><option value="realizado">Realizado</option><option value="evaluacion">Evaluación</option></select></div>
  <div class="field span2"><label>Referencia de clases *</label><input name="clases_ref" required maxlength="100"></div><div class="field span2"><label>Manual / páginas</label><input name="manual_ref" maxlength="100"></div>
  <div class="field span2"><label>Tema</label><textarea name="tema" rows="3" maxlength="500"></textarea></div><div class="field span2"><label>Enlace de Google Meet (opcional)</label><input type="url" name="meet" placeholder="https://meet.google.com/..."></div>
</div><div class="modal-actions"><button type="button" class="btn" data-close="eventDialog">Cancelar</button><button class="btn primary">Guardar</button></div></div></form></dialog>

