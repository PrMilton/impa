<script>
const IMPA_FS_DOC='https://firestore.googleapis.com/v1/projects/formulario-7d5cb/databases/(default)/documents/congregacion_data/mainData';
async function impaRequest(url,options={}){const controller=new AbortController(),timeout=setTimeout(()=>controller.abort(),10000);try{const response=await fetch(url,{...options,signal:controller.signal,headers:{'Content-Type':'application/json',...(options.headers||{})}});if(!response.ok)throw new Error(`Firestore ${response.status}: ${await response.text()}`);return response.json()}finally{clearTimeout(timeout)}}
function impaParse(doc,name,fallback){const raw=doc?.fields?.[name]?.stringValue;if(typeof raw!=='string')return fallback;try{return JSON.parse(raw)}catch{return fallback}}
window.loadImpaAcademicData=async function(){const doc=await impaRequest(IMPA_FS_DOC);return window.impaAcademicData={exams:impaParse(doc,'instituteExams',{}),attempts:impaParse(doc,'instituteAttempts',{})}}
async function saveInstituteStudents(value){return impaRequest(`${IMPA_FS_DOC}?updateMask.fieldPaths=instituteStudents`,{method:'PATCH',body:JSON.stringify({fields:{instituteStudents:{stringValue:JSON.stringify(value)}}})})}
async function syncInstituteStudents(button=null){const status=document.querySelector('#firebaseSyncStatus'),students=window.getImpaFirebaseStudents();if(button){button.disabled=true;button.textContent='Sincronizando…'}try{await saveInstituteStudents(students);if(status){status.textContent=`Sincronización completa: ${Object.keys(students).length} alumnos con DNI disponibles para exámenes.`;status.className='notice'}console.info(`IMPA: ${Object.keys(students).length} alumnos sincronizados`)}catch(err){if(status){status.textContent='No se pudo sincronizar con Firestore: '+err.message;status.className='notice warning'}console.error(err)}finally{if(button){button.disabled=false;button.textContent='Sincronizar alumnos con Firebase'}}}
document.addEventListener('click',e=>{const button=e.target.closest('#syncFirebase');if(button)syncInstituteStudents(button)});
syncInstituteStudents();
window.loadImpaAcademicData().catch(err=>console.warn('Resultados de exámenes no disponibles:',err.message));
</script>
</body>
</html>
