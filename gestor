  function normalizeStudent(s){return {...s,nombreCompleto:titleCase(s.nombreCompleto||[s.nombre,s.apellido].filter(Boolean).join(' ')||''),institucion:titleCase(s.institucion||s.iglesia||''),localidad:titleCase(s.localidad||''),rol:s.rol||'',autorizado:Boolean(s.autorizado)}}
  function addContactSeed(x){x.imports=x.imports||[];if(x.imports.includes('instituto-csv-2026-08-28'))return x;const phones=new Set(x.students.map(s=>(s.telefono||'').replace(/\D/g,'')));contactSeed.forEach((c,i)=>{const digits=c[1].replace(/\D/g,'');if(!phones.has(digits)){x.students.push(normalizeStudent({id:'csv'+(i+1),nombreCompleto:c[0],dni:'',telefono:c[1],institucion:c[2]?'Iglesia Metodista Pentecostal Argentina':'',localidad:'',rol:c[2],autorizado:false,estado:'Activo',observaciones:'Importado desde insitituto.csv'}));phones.add(digits)}});x.imports.push('instituto-csv-2026-08-28');return x}
  function ensureAcademicData(x){x.subjects=Array.isArray(x.subjects)&&x.subjects.length?x.subjects:structuredClone(initial.subjects);x.enrollments=x.enrollments&&typeof x.enrollments==='object'?x.enrollments:{};x.courseData=x.courseData&&typeof x.courseData==='object'?x.courseData:{};x.subjects.forEach(s=>{x.enrollments[s.id]=Array.isArray(x.enrollments[s.id])?x.enrollments[s.id]:[];x.courseData[s.id]=x.courseData[s.id]||{events:[],attendance:{}}});if(!x.migrations?.courseDataV1){x.courseData.antropologia={events:Array.isArray(x.events)?x.events:[],attendance:x.attendance||{}};x.enrollments.antropologia=x.students.map(s=>{const old=x.enrollments.antropologia.find(e=>e.studentId===s.id);return old||{studentId:s.id,modalidad:'regular',notas:[]}});x.migrations={...(x.migrations||{}),courseDataV1:true}}return x}
